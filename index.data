}gºJc%¼Å!Ó»Şˆ,åx”ªl™1Ô	óLğ¥hÇŒuªlZÚH'␀f0ÌÊç‹É¶Êş_,·hş˜␀␀␀␀IEND®B`‚# Creature shots fly twice as fast and hit a little wider (an example of
# [shots.*] and [policy]; see mods/README.md).
[shots.Fireball]
speed_x4096 = 7372

[shots.Arrow]
speed_x4096 = 9830

[shots.Knives]
speed_x4096 = 9830

[policy]
shot_hit_radius_x4096 = 1536
title = "Swift shots"
description = "Fireballs, arrows and knives fly twice as fast and hit a little wider."
kind = "gameplay"
title = "Torchlight"
description = "A darker dungeon and a warmer, wider hand light. Use this or Depths, not both."
kind = "graphics"
# Darker dungeon, warmer and larger Keeper hand light.
[lighting]
ambient = [0.02, 0.018, 0.016]
cap_ambient = [0.4, 0.35, 0.3]      # tops still read from above

[lighting.terrain]
intensity = 0.35

[lighting.hand]
radius = 3.9
intensity = 1.4
height = 1.0
