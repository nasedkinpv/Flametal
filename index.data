ÂÉ€0+«"ÌÏ"Ô%äiá¼Œ UµHVPw\!’:qˆğï!İ™f›³T§á¥tŞö„ó†ó€å’¼¦êªuø£-nŸ?Çaš˜Ou—6¥jÇD€^dLÆ$ŸÓ|¢3I?U¹Kq¾˜Çùõí:¯ˆ7N&kCQEp‘Ê7ÂÑá]Š´9M¨¼ã(åôòØÃE•­HæZ‰4ÛŠ¬¤8ŒÔ£i‚På–X¹£åC!#åÚ-nğ'[M´Íx,:1´ÿ§¨×îµÏ‰°46‹ÇÓ‰ñVÚ˜ç[j[™#ŸÌbMÇ–E2ñ¤éäUà ¬M!g~"»÷Ë—Ï0ĞD™©a•èÜı~;Î³ ²ší!fšmh¾ßçyáõ¼f.Ëı³*Ü¦Ó>À{İœôÎ¡×7Ù7•½à¹TÿË$´zk‘D¡9o·ûÇcİRù#Ä£m}]OÓøÆ6@ø1Ù_h›®oM?Vùj¦u¥-Kº°—+8è,‹’Àr¥aâ␀J¥ Ÿ³ªO„¸ìÏ9$FÜq®bMeÒ#§|e†²QR‡6ep©…Â8ÈÅC Ü2”ÏA’¶␀@%7‹=Pš‘AËàäORŸi"¢␀é¢(|Q)2.ÕŞyv4ø'K52†ÍzÅ\ÜL`åj3¦yŞ÷½ë¡WÉ•]/=:Èş›ªX.ƒ9¹myX'ë¥ê×#¤˜EªuaÜ˜A#úbÔ!;$ŒvVœRu'Şè¾-tDh`DÛ¯¿üüÏß~['ìaÏkØì9èaıJÏgÌ²q¢	›ÖË$l“AI¶ÀT¡W—£	2jc…‘µÿD‘UÂçW-:␀␀␀␀IEND®B`‚# Computer keepers attack sooner and more often in skirmish, at every
# difficulty: fewer fighters are enough, a lower level, half the pause.
[ai."*"]
min_creatures_to_attack = 4
attack_skill_level = 3
attack_cooldown = 45
attack_superiority = 80
title = "Fiercer keepers"
description = "Computer keepers attack sooner and more often in skirmish."
kind = "ai"
# A new creature (an example of [new_creatures], [new_shots] and
# [new_creature_spells]; see mods/README.md): the Goblin's record, art and
# animations under a new name, hitting harder and slower, spitting fire
# from level 3, three of them for every keeper's portal.
[new_shots."Fire Spit"]
base = "Fireball"
data1 = 120                       # damage
speed_x4096 = 4915                # 1.2 tiles a turn

[new_creature_spells."Fire Spit"]
base = "Warlock Fireball"
shot = "Fire Spit"
range_x4096 = 12288               # 3 tiles

[new_creatures."Fire Goblin"]
base = "Goblin"
title = "Fire Goblin"             # its name in the game
pool = 3
melee_damage = 320
melee_recharge_turns = 8
hp = 1800
pay = 120
spell1 = "Fire Spit"
spell1_level = 3
# Its own meshes would go in mods/fire-goblin/Data/Meshes/FireGob*.kmf
# (the Goblin's names with Gob -> FireGob); those not shipped are the Goblin's.
art_from = "Gob"
art_to = "FireGob"
title = "Fire Goblin"
description = "A new creature: a tougher Goblin that spits fire from level 3. Three in every portal."
kind = "content"
# Lights the creatures carry (README: light_color, light_radius, light_height,
# light_flags, light_strength_percent; 4096 = a tile). The game's own: the
# Imp's and Dwarf's lanterns, the Firefly's 1.5-tile glow; the elite Firefly
# and the Fairy have none.

[creatures.Firefly]
light_radius = 12288              # 3 tiles: it flies high, its own 1.5 hardly reaches the floor
light_strength_percent = 250

[creatures."Unique Firefly"]
light_color = 0xB060FF            # violet, as it looks
light_radius = 12288
light_strength_percent = 250
light_flags = 0x4                 # it pulses

[creatures.Fairy]
light_color = 0xC8DCFF
light_radius = 10240
light_strength_percent = 200
title = "Creature glow"
description = "Fireflies light the floor under them; the elite Firefly glows violet, the Fairy a pale blue."
kind = "graphics"
# Habits: every kind of creature has a comfort of its own (see mods/README.md, "Needs" and "Jobs").
#
# 1. A craft it enjoys. The original's records give some jobs a mood value - the Mistress and the
#    Salamander 10 for training, the Monk 20 for prayer - that the game loads and never reads. This
#    mod switches it on (value x job_mood_scale comes off every anger each second at that job) and
#    gives the other craftsmen theirs.
# 2. A room it visits. Kinds with no craft take a short break every few minutes in a room that suits
#    them; it calms them. If their keeper could build that room and has none they can reach, they
#    slowly grow sour (the anger a night in the lair clears).

[policy]
job_mood_scale = 10               # the Mistress at training: 100 a second (prayer gives 275)

# --- crafts (happy_job<N>_mood: the N-th entry of the kind's own happy list) ---
[creatures.Mistress]
happy_job2_mood = 15              # her own turn on the wheel
[creatures."Unique Mistress"]
happy_job1_mood = 10              # (the record gives the plain one 10 for training, the unique none)
happy_job2_mood = 15
[creatures.Warlock]
happy_job1_mood = 8               # research
[creatures."Unique Warlock"]
happy_job1_mood = 8
[creatures.Troll]
happy_job1_mood = 10              # manufacture
[creatures."Unique Troll"]
happy_job1_mood = 10
[creatures."Dark Elf"]
happy_job1_mood = 8               # guard duty
[creatures."Unique Dark Elf"]
happy_job1_mood = 8
[creatures."Unique Salamander"]
happy_job1_mood = 10              # training, as the plain one's record has it

# --- visits ---
[needs.vigil]                     # the Vampire stands among the graves it rose from
creatures = ["Vampire", "Unique Vampire"]
room = "Graveyard"
every_seconds = 420
stay_seconds = 12
calm = 3000
anger_per_turn = 6
animation = 23                    # praying
order = 50                        # after the original's four

[needs.devotion]                  # the Dark Angel kneels in the Temple
creatures = ["Dark Angel", "Unique Dark Angel"]
room = "Temple"
every_seconds = 480
stay_seconds = 10
calm = 3000
anger_per_turn = 6
animation = 23
order = 51

[needs.ringside]                  # the Black Knight looks in on the Combat Pit
creatures = ["Black Knight", "Unique Black Knight"]
room = "Combat Pit"
every_seconds = 480
stay_seconds = 10
calm = 2500
anger_per_turn = 6
order = 52

[needs.larder]                    # the Bile Demon makes its rounds of the Hatchery between meals
creatures = ["Bile Demon", "Unique Bile Demon"]
room = "Hatchery"
every_seconds = 360
stay_seconds = 8
calm = 2000
heal_percent = 5
anger_per_turn = 6
order = 53

[needs.forge]                     # the Salamander warms itself at the Workshop's fires
creatures = ["Salamander", "Unique Salamander"]
room = "Work Shop"
every_seconds = 420
stay_seconds = 10
calm = 1500
heal_percent = 10
anger_per_turn = 6
order = 54

[needs.tables]                    # the Goblin goes to watch the wheels turn
creatures = ["Goblin", "Unique Goblin"]
room = "Casino"
every_seconds = 480
stay_seconds = 8
calm = 2000
anger_per_turn = 6
order = 55

[needs.hoard]                     # the Rogue counts the keeper's gold
creatures = ["Rogue", "Unique Rogue"]
room = "Treasury"
every_seconds = 360
stay_seconds = 8
calm = 2000
interrupts = ["research", "train", "manufacture", "guard", "pray", "gamble", "sulk", "cheer", "explore"]
order = 56

[needs.glow]                      # the Firefly comes back to the Heart's light
creatures = ["Firefly", "Unique Firefly"]
room = "Dungeon Heart"
every_seconds = 300
stay_seconds = 6
calm = 1500
interrupts = ["research", "train", "manufacture", "guard", "pray", "gamble", "sulk", "cheer", "explore"]
order = 57
title = "Habits"
description = "Every kind has a comfort of its own: a craft it enjoys or a room it visits."
kind = "gameplay"
# A faction (mods/README.md, "Factions"): picked for a keeper in the skirmish set-up.
# The heroes' own keeper: its portal brings only these (with the rooms each wants - a Knight
# needs a Combat Pit), and it builds none of the dark rooms. Its workers are still Imps.

[factions.Heroes]
title = "Heroes"
creatures = [["Dwarf", 12], ["Guard", 10], ["Elven Archer", 10], ["Knight", 10], ["Wizard", 8],
             ["Thief", 8], ["Monk", 8], ["Fairy", 8], ["Giant", 6]]
rooms = ["Dungeon Heart", "Portal", "Treasury", "Lair", "Hatchery", "Library", "Training Room",
         "Work Shop", "Guard Room", "Prison", "Temple", "Combat Pit", "Wooden Bridge", "Stone Bridge"]
title = "Hero Keeper"
description = "A side for skirmish: a keeper of the heroes. Its portal brings knights, dwarves, wizards and the rest of the Realm; no torture, graveyard, casino or crypt."
kind = "content"
# Imp triage / worker priorities

Enable **Imp triage** to try the [example](game.toml), or put a `[workers]`
table in your own mod's `game.toml`. It applies to all keepers' workers,
including converted Dwarves.

```toml
[workers]
idle = ["rescue", "dig", "corpse"]
drop = ["dig", "rescue", "corpse"]
```

**Idle**: the next time a worker needs work, try each named task in order. Here
it rescues a downed creature first, then digs or mines visible tags, then fetches
a corpse. No active job is interrupted.

**Drop**: on an ordinary hand drop, try the named tasks within two tiles
(Manhattan distance). Then try the usual nearest reachable local work.
If there is none, use the idle order across the map. A drop right beside a
dig site will not send the worker to a distant corpse first in this profile.

These are preferences, not an allowlist. If none works, the usual DK2 follow-ups
and groups still apply. Full cargo and special room drops keep their rules;
delivery, capacity, slot reservations, combat and flight are not configurable jobs.

Accepted names: `rescue` (fetch an unconscious creature for a lair or prison),
`corpse` (to a Graveyard), `dig` (including ore), `fog_dig` (unseen tags),
`claim` (floor), `convert_room`, `attack_floor`, `reinforce`, `repair`,
`collect_gold` (loose piles), `crate` (workshop order) and `loose_object` (books, specials, loose crates).

An omitted key inherits the previous mod's list for that context. An empty list
(`drop = []`, for example) restores its built-in mode, including
`[policy] workers_rescue_first` (default 1, which checks the whole map even on
a drop). An explicit non-empty list replaces that early rescue check for its
context. Unknown names, duplicates and non-string entries are errors.
[workers]
idle = ["rescue", "dig", "corpse"]
drop = ["dig", "rescue", "corpse"]
title = "Imp triage"
description = "Free workers rescue the living, dig, then move corpses. A hand-dropped worker looks for digging nearby first."
