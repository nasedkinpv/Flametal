×£=R¸¿=
×>)\>R¸¿ìQ8>)\>R¸¿# Strip Club - a new room

A velvet night club deep in the dungeon: red light, a worn plank dance floor, a bar counter with
stools along the wall, cocktail tables with velvet armchairs along the walls (one every second tile: a
bigger room has more), booths in the walls, and in a room with a 5x5 inside, a brass dancer's pole on a round stage at its centre.
Mistresses and Maidens of the Nest of a keeper who has one come every four minutes, dance most of a minute
and leave calmer - a Mistress now and then tipsy, walking drunk for a while (`drunk_percent`); a keeper
who could build one and has none finds them souring.

Made as the Bathhouse is (mods/bathhouse/README.md is the walkthrough; mods/README.md "Making a new
room" the parts); laid out as the Lair, nothing of the Lair's own (no beds).

| File | What it is |
|---|---|
| `game.toml` | The room (`[new_rooms."Strip Club"]`, its pole `ritual_object`, the bar `around_centre`, the tables `along_walls`), the two objects (`[new_objects.*]`), its light (`[terrain."Strip Club"]`), the need (`[needs.club]`). |
| `Data/Meshes/CLUB<n>.kmf`, `CLUB_POLE.kmf`, `CLUB_BAR.kmf` | Its pieces, made by `source/make.zsh` from `source/pieces.py` (shared drawing: tools/kmf/meshlib.py). |
| `textures/` | Plank floor, velvet wall, buttoned velvet, wood and brass (an image model, gpt-image-2.6, with the game's HD-pack pictures as style references: bridge planks, Slab, Library carpet), the bottles' glass (drawn), the icon. |
| `source/prompts/` | The prompts. |

The pole dance (`Data/Meshes/MIS_PoleDance.kmf`, made by `tools/anim/make_clip.py` from the
Mistress's own mesh) is derived from the game's data: it stays in the repository for development
and out of public releases (`docs/RELEASE-EXCLUSIONS.md`). Everything else here is our own.
# The Strip Club: a new room (mods/README.md, "Making a new room"; this mod's README).
# Laid out as the Lair it is made from, with pieces of its own - a velvet night club deep in the
# dungeon - and, in a room with a 5x5 inside, a dancers' pole on a round stage at its centre and a
# bar counter by the wall behind it. Nothing of the Lair's own comes with it: no beds.
#
# Mistresses and Maidens of the Nest of a keeper who has one come every four minutes, dance most of a
# minute and leave calmer; a keeper who could build one and has none finds them souring.

[new_rooms."Strip Club"]
base = "Lair"
title = "Strip Club"
cost = 350                        # gold a tile
icon = "gui\\rooms\\stripclub"    # textures/gui_rooms_stripclub.png
art_from = "LAIR"                 # its pieces are CLUB<n>: Data/Meshes/CLUB<n>.kmf in this mod,
art_to = "CLUB"                   # made by source/make.zsh
drop = 0                          # a creature set down there just stands (the Lair's own: it takes a bed)
lodging = 0                       # it draws no creatures through the portal
ritual_object = "Dancer Pole"     # the pole on its stage, at the centre of the first 5x5 of the room
around_centre = [["Bar Counter", 0, -2, 0]]   # the bar two tiles behind it, along the wall
along_walls = [["Club Table", 2]]  # a table with two armchairs on every second tile along a wall: more room, more tables

[new_objects."Dancer Pole"]
base = "Temple Hand"
mesh = "CLUB_POLE"

[new_objects."Bar Counter"]
base = "Temple Hand"
mesh = "CLUB_BAR"

[new_objects."Club Table"]
base = "Temple Hand"
mesh = "CLUB_TABLE"

[terrain."Strip Club"]            # its floor's light: low, red and warm
light = [175, 55, 80]
ambient = [22, 8, 12]
light_height_percent = 215

[needs.club]
room = "Strip Club"
creatures = ["Mistress", "Unique Mistress", "Maiden Of The Nest"]
every_seconds = 240               # each comes every four minutes
stay_seconds = 45                 # ... and dances most of a minute
# from any work - torturing too (a Mistress's love), else with prisoners in she never comes
interrupts = ["research", "manufacture", "train", "pray", "gamble", "guard", "sulk", "cheer", "torture", "explore"]
calm = 3000
drunk_percent = 30                # leaves tipsy now and then: the drunk walk for a while (as the casino's barrels)
drunk_seconds = 45
anger_per_turn = 3                # while it is due and there is none to go to
animation = 28                    # dancing (the game's own), where no clip of this mod's is given
clip = "pole_dance"               # ... and at the pole a Mistress dances this mod's (below)
centre = 1                        # the first goes to the pole (the centre of the room's 5x5)
interior = 1                      # the rest on the floor, not in the booths
order = 61

[creature_animations.Mistress]     # a clip of this mod's: Data/Meshes/MIS_PoleDance.kmf, made by
pole_dance = { mesh = "MIS_PoleDance", fps = 20 }   # tools/anim/make_clip.py (tools/anim/clips/pole_dance.py)
[creature_animations."Unique Mistress"]
pole_dance = { mesh = "MIS_PoleDance", fps = 20 }
title = "Strip Club"
description = "A new room: a velvet club with a bar and a dancer's pole. Mistresses and Maidens of the Nest come to dance and unwind."
kind = "content"
