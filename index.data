␀␀␀␀␀␀␀␀␀␀␀␀␀d␀␀␀␀␀␀␀␀␀È␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀d␀␀␀␀␀␀␀␀␀È␀␀␀␀␀␀␀␀␀	␀␀␀␀␀␀␀␀␀␀d␀␀␀␀␀␀␀␀␀Ò␀␀␀␀␀␀$␀␀␀Ó␀␀␀␀␀␀␀␀␀␀␀␀␀␀Ô␀␀␀␀␀␀␀æ␀␀␀␀␀␀ ␀␀␀ç␀␀␀␀␀␀␀␀␀␀è␀␀␀␀␀␀␀# Relief Gallery

A small skirmish level for looking at the [relief](../relief/render.toml) mod: your heart on
claimed floor among pillars and wall seams of gold and gems, a block of rock and one of
impenetrable rock, reinforced walls with their torches, a Firefly and a Fairy. The other keeper is
walled off in the east.

```sh
python3 tools/native/run_level.py --level ReliefGallery --skirmish --mod relief-gallery --mod relief
```

Source: `source/ReliefGallery.toml` (hand-made), built by
`python3 tools/dk2map/dk2map.py build mods/relief-gallery/source/ReliefGallery.toml --game "$GAME" --out mods/relief-gallery/Data/editor/maps`.
title = "Relief Gallery"
description = "A small level for looking at the relief mod: your heart among pillars and seams of gold and gems, rock, impenetrable rock and torch-lit walls."
kind = "maps"
title = "Relief"
description = "Stone, gold and gems, brick and floors catch the light: a normal map made from each texture bends the torchlight on it."
kind = "graphics"
# Normal maps on the dungeon's walls and floors (README: [relief]). Made at
# load from the picture drawn - the game's or an HD pack's - or a pack's own
# <name>_n.png; a pack's <name>_s.png is its gloss mask (else the picture's
# brightness).
[relief]
strength = 1.5                    # how far the bumps bend the light (0: off)
cavity = 0.5                      # how much light a crevice loses
gloss = 0.0                       # highlights: none but the groups'
shininess = 32
textures = ["t_*", "brick*", "*floor*", "*flr*", "*wall*", "herofloor*", "herowall*", "3dfe_*",
            "pitfloor", "plaster*", "slab*", "rock *", "crypt*", "dheart*", "d heart*"]

# Unworked rock and earth seen from above: lit from overhead, they want more.
[[relief.group]]
textures = ["t_rock_top*", "t_impen_rock*"]
strength = 2.5

# Gold glints its own colour, gems sharper; the heart's stone a little.
# (Seen from above at a slant under lights from above: a broad highlight
# reaches flat ground, a narrow one only the bumps.)
[[relief.group]]
textures = ["t_gold*"]
gloss = 4
shininess = 12
metal = true

[[relief.group]]
textures = ["t_gems*"]
gloss = 4
shininess = 24
metal = true

[[relief.group]]
textures = ["dheart*", "d heart*"]
gloss = 0.15
shininess = 24

# Polished floors (their gloss masks from a pack: the claimed tiles' gem, worn stone): a little.
[[relief.group]]
textures = ["t_claimed_path*", "herofloor*", "treasure floor*", "prison_floor*"]
gloss = 0.3
shininess = 24
