V9¼å‹÷¬.ÿµ’d¤Lù>ª>T˜°WÂÌÊC­,Z~¡P—é␀Ñè¥Ç¹6§_¦Jº u*í¯È•¨æD7.Çå¹˜AP3[­ş*JyG•6õêù«¨ËÔEUâÊÅM]U?©Ş²+²¦E²¸j…­-p¹É•RâyJzªR«HWÕÅ¾â{«™µìkE¾ší_+!š®R"­úHòT$š+.%'Œ ¨Í4Šÿ/¿*’™ò␀␀␀␀IEND®B`‚# Bigger Portals: how many creatures the portals bring a keeper (those that came through them; the
# rest - converted, summoned, found - do not count). The game's: 15 for the first portal, 5 for each
# more. Twice that here, for big dungeons full of rooms.
[variables]
CREATURES_SUPPORTED_BY_FIRST_PORTAL = 30
CREATURES_SUPPORTED_PER_ADDITIONAL_PORTAL = 10
title = "Bigger Portals"
description = "Portals bring twice the creatures: 30 for the first, 10 for each more (the game's: 15 and 5)."
kind = "gameplay"
title = "Classic fog"
description = "The fog of war as the original draws it: plain rock over everything unexplored."
kind = "graphics"
# The fog of war exactly as the original draws it: unexplored tiles are plain
# rock blocks (the Fog Of War terrain), with no mist over them.
[fog]
style = "original"
# The Debug tab (src/native_game/DebugTab.h): a tab of the panel like any a mod adds, its items
# the "debug:*" selector - the debug buttons and every creature kind, a mod's too.
#   gold +10000 (what the stores cannot hold lies in piles by the heart), the treasuries filled,
#   full mana, every creature of the keeper one level up, the whole map revealed;
#   a creature's card spawns one for the keeper on the open tile nearest the view's centre.
# Each goes to the simulation as a command, as the player's own do: a save keeps and replays them.

[[hud.tab]]
key = "debug"
title = "Debug"                   # no icon: the tab shows its title
items = ["debug:*"]
title = "Debug panel"
description = "A Debug tab in the panel for testing mods: spawn any creature, gold, full mana, levels, the whole map."
kind = "gameplay"
title = "Depths"
description = "A dark dungeon in dense fog: warm light from lava and torches, cold deep water."
kind = "graphics"
# Depths: the dungeon far down. Almost no light of its own, a cold one where
# there is; what you see, you see by fire - lava, torches, the hand - and the
# unexplored lies under a deep, slow mist.

[lighting]
ambient = [0.014, 0.018, 0.026]     # a breath of cold light, so black is never flat
cap_ambient = [0.24, 0.25, 0.30]    # the map still reads from above, in moonlight colours
terrain_ambient_scale = 0.42

[lighting.terrain]                   # the claimed floor's own glow: low, the fires carry the picture
intensity = 0.38

[lighting.terrain_color]
4 = [0.13, 0.31, 0.44]               # water: deep and cold
5 = [1.00, 0.40, 0.07]               # lava: the warmest thing in the dungeon

[lighting.terrain_radius]
5 = 3.7                              # lava lights the rock well back from its banks

[lighting.terrain_intensity]
5 = 0.29                             # ... and fades over that distance instead of flooding it

[lighting.torch]                     # torches: fewer lumens of the original's yellow, more of fire
intensity = 1.6
radius = 1.25
tint = [1.0, 0.74, 0.46]

[lighting.hand]                      # the hand carries a lantern
radius = 3.9
intensity = 1.5
height = 1.1
color = [1.0, 0.72, 0.40]

[backdrop]
water_alpha = 0.62
water_tint = [0.72, 0.90, 1.0]
lava_glow = 1.5
water_foam = 0.6                     # a little more foam: in this light it is dim
lava_crust = 0.7                     # a broader cooled crust: black banks round the fire

[fog]
style = "modern"
color = [0.028, 0.028, 0.030]        # a very dark grey deep in
mist = [0.100, 0.100, 0.105]         # ... the mist over it a dark grey: its wisps show as they drift
wisps = 0.9
opacity = 1.0
speed = 0.035
scale = 0.08                         # broad, slow banks rather than a fine haze
height = 0.42                        # it stands well over the rock
layers = 3
glow = [0.16, 0.075, 0.03]           # the explored edge smoulders
edge = 0.8
depth = 2.5
