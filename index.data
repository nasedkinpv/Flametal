# Native renderer settings (lane B). Every key is optional.
# Load order: this file, then each enabled mod's render.toml (see mods/README.md).
# Light colours, heights and room ambients come from the original Terrain.kwd;
# the numbers below are native render policy, not recovered original values.

[lighting]
enabled = true
ambient = [0.05, 0.045, 0.04]      # added to every lit surface, 0..1
cap_ambient = [0.55, 0.5, 0.44]     # block tops (each vertex facing up at the top plane), so the map reads from above as in the original
terrain_ambient_scale = 0.5         # scales Terrain.kwd ambient_light (rooms)
keep_hue = true                     # light over 1 dims whole and keeps its colour (many lava lights stay orange);
                                    # false = each channel clips, as the original (they turn yellow, then white)

[lighting.terrain]                   # one light per lit floor cell (claimed path, rooms...)
radius = 2.5                         # world units (1 = one cell), max 3.99
intensity = 0.5                      # light factor one unit away, facing the surface
color_scale = 1.0
shadows = false                      # with ray-traced shadows on (Options; off: --no-rt-shadows): fill lights cast too (greys the image); torches and the hand always do

# Per-terrain light colour overrides (Terrain.kwd id -> [r, g, b]). Lava's
# Terrain.kwd terrain_light is (44, 100, 20), a green that reads wrong for a
# self-lit orange surface, and water's (100, 44, 250) a violet; these are
# presentation choices.
[lighting.terrain_color]
4 = [0.25, 0.45, 0.6]                # Water: Terrain.kwd (100, 44, 250) floods water and its banks violet
5 = [0.9, 0.4, 0.1]

# One terrain's own light instead of [lighting.terrain]'s radius / intensity
# (Terrain.kwd id -> number), e.g. a wider, hotter glow from lava:
# [lighting.terrain_radius]
# 5 = 3.2
# [lighting.terrain_intensity]
# 5 = 0.8

[lighting.torch]                     # the game's own lights: wall torches, a portal's, spells' and effects'
intensity = 1.0                      # scales their original intensity
radius = 1.0                         # scales their original radius (a light's stays under 4)
tint = [1.0, 1.0, 1.0]               # multiplies their original colour

# Relief: normal maps on the textures named (globs, any case), made from the
# picture drawn or a pack's <name>_n.png. NATIVE PRESENTATION; mods/relief.
[relief]
strength = 0.0                       # 0: off
cavity = 0.35                        # how much ambient a crevice loses, 0..1
textures = []

[lighting.hand]                      # Keeper hand light under the cursor
radius = 3.5
intensity = 0.9
height = 1.25                        # above the floor
color = [1.0, 0.86, 0.62]

# Terrain backdrop: simple geometry for map cells the native Scene does not
# draw yet (rock caps and walls, floors, liquid beds), so the dungeon around
# the playable area is visible. Keys are Terrain.kwd ids; texture names are
# engine cache names without the mip suffix. Solidity comes from Terrain.kwd.
[backdrop]
enabled = true
mip = 0
bank = "T_Rock_wall"                # wall between ground and water/lava
modern_liquids = true               # water/lava: world-space, seamless, flowing (DK2LiquidShader.metal); false = flat tiles
water_alpha = 0.55                  # modern water's opacity at the banks (the bed pieces show through)
deep_water_alpha = 0.97             # ... rising to this a few tiles out: deep water, darker
water_tint = [1.0, 1.0, 1.0]        # modern water's colour, multiplied (0..1; its light is [lighting.terrain_color] 4)
lava_tint = [1.0, 1.0, 1.0]         # modern lava's colour, multiplied (0..1; it stays self-lit)
lava_glow = 1.0                     # how hot modern lava's cracks burn, 0..2
water_foam = 0.5                    # foam where modern water meets its bank: 0 none .. 1 a broad, heavy band
lava_crust = 0.5                    # cooled crust where modern lava meets its bank: 0 none .. 1
default_solid = { top = "T_Rock_top2", wall = "T_Rock_wall" }   # terrain ids not listed below
default_open = { floor = "T_Claimed_Path1" }

[backdrop.terrain]
1  = { top = "T_Impen_Rock", wall = "T_Impen_Rock2" }       # Impenetrable Rock
2  = { top = "T_Rock_top2", wall = "T_Rock_wall" }           # Rock
3  = { floor = "T_Rock_Floor2" }                             # Dirt Path
4  = { floor = "Water0", liquid = true, frames = 32, fps = 10 } # Water: Water0..31 animate (fps is render policy)
5  = { floor = "Lava0SOLID", liquid = true, emissive = true } # Lava (self-lit)
6  = { top = "T_Gold_Top", wall = "T_Gold_Wall" }            # Gold
7  = { top = "T_Gems_Top", wall = "T_Gems_Wall" }            # Gems
8  = { floor = "T_Claimed_Path1" }                           # Claimed Path
9  = { top = "T_Claimed_TopGood", wall = "T_Rock_wall2" }    # Reinforced Wall
10 = { floor = "T_Claimed_Path1" }                           # Treasury
11 = { floor = "T_Claimed_Path1" }                           # Lair
12 = { floor = "T_Claimed_Path1" }                           # Portal
13 = { floor = "T_Claimed_Path1" }                           # Hatchery
14 = { floor = "T_Claimed_Path1" }                           # Dungeon Heart
15 = { floor = "T_Claimed_Path1" }                           # Library
16 = { floor = "T_Claimed_Path1" }                           # Training Room
17 = { floor = "T_Claimed_Path1" }                           # Wooden Bridge
18 = { floor = "T_Claimed_Path1" }                           # Guard Room
19 = { floor = "T_Claimed_Path1" }                           # Work Shop
20 = { floor = "T_Claimed_Path1" }                           # Prison
21 = { floor = "T_Claimed_Path1" }                           # Torture Chamber
22 = { floor = "T_Claimed_Path1" }                           # Temple
23 = { floor = "T_Claimed_Path1" }                           # Graveyard
24 = { floor = "T_Claimed_Path1" }                           # Casino
25 = { floor = "T_Claimed_Path1" }                           # Combat Pit
26 = { floor = "T_Claimed_Path1" }                           # Stone Bridge
30 = { top = "T_Impen_Rock", wall = "T_Impen_Rock2" }       # Edge of Map
27 = { }                                                     # Fog Of War: not drawn
41 = { floor = "T_Claimed_Path1" }                           # Crypt

[fog]                                # fog of war look
style = "modern"                     # "modern": plain rock blocks under drifting, softly edged mist
                                     # "original": the plain rock blocks only, as DKII-DX.exe (mods/classicfog)
color = [0.020, 0.018, 0.016]        # near black, a touch warm: gloom, not haze
# mist = [0.05, 0.05, 0.05]          # the drifting layers in their own colour (lighter: their wisps show); unset = color
wisps = 0.45                         # how far the mist thins between its wisps: 0 even .. 1 clear gaps
opacity = 0.95
speed = 0.06                         # mist drift, tiles per second
scale = 0.22                         # mist texture repeats per tile
height = 0.12                        # above the block tops, tiles
layers = 2
glow = [0.09, 0.06, 0.035]           # a faint ember rim along the explored edge (0 = none)
edge = 0.4                           # the mist on the first fogged tile: thin, the ground shows through
depth = 4                            # tiles into the fog until it hides everything

[audio]                              # how it sounds (the original's samples; native_game/Audio)
volume = 1.0                         # everything
speech = 1.0                         # level scripts' voice
effects = 0.8                        # creatures, rooms, digging, spells
music = 0.35
interface = 0.7                      # panel clicks
hear_tiles = 14                      # effects fade out to this distance from the camera
music_track = "1"                    # Track_1 or Track_3

[effects]                            # visual effects' look (Effects.kwd particles)
modern = true                        # soft round sprites fading into the floor, blended ones sorted back to front; false = classic quads
# Native mods

A mod is a folder: the shipped ones under `mods/`, the player's own in
`Mods` of the player's data folder - `~/Library/Application Support/Dungeon Keeper II`
on macOS, `$XDG_DATA_HOME` (or `~/.local/share`)`/Dungeon Keeper II` on Linux,
`%APPDATA%\Dungeon Keeper II` on Windows; on the iPad the app's Documents/Mods,
through Files. A player's mod of the same name wins.
Turn them on in the game - Options, the Mods tab (from the level menu's
"Options and mods" or the pause menu). Several apply in the order they were
turned on, later ones win; the list is kept in `settings.toml` (`[mods] on`).

- Graphics (`render.toml`): the lighting switches at once, fog and effects
  from the next level; `textures/` after a restart.
- Gameplay and content (`game.toml`, `Data/...`): from the next new game. A
  save keeps them (by name and path) and plays with them when loaded.

For a map mod instead, see [the ASCII skirmish guide](../docs/agents/guides/author-skirmish-maps.md) and [The Velvet Aqueduct](velvet-aqueduct/README.md).

## First mod: change the hand light

Create `mods/blue-hand/render.toml` with just these lines (no manifest needed):

```toml
[lighting.hand]
color = [0.1, 0.3, 1.0]
```

From the checkout root, with `GAME` set to your original installation, run:

```sh
python3 tools/native/run_level.py --game "$GAME" --level Level1 --mod torchlight --mod blue-hand
```

Move the hand over a lit floor: its light should be blue rather than Torchlight's amber. Reverse the two `--mod` arguments to see Torchlight's colour win; its other keys apply in both runs. Explicit names replace the saved selection for this run. The wrapper checks for each name under the checkout's `mods/`; use Options â†’ Mods for a player-only folder, or run `build/native-host-release/native_play` with `--game`, `--level`, `--mods-root DIR` and `--mod NAME` directly. For load errors inspect `play.log` in the launcher's output directory. A save records its gameplay mod selection, not a copy of the mod: keep those folders installed.

Relief maps are made at load from the picture drawn (the game's or a pack's);
both hosts draw them (the WebGPU host makes them again each run: no cache yet).
A texture pack or a mod's `textures/` may ship its own as `<name>_n.png`:
red and green the normal's x and y towards the picture's right and bottom
(DirectX's convention), blue the height (0.5 the surface; lower is a crevice),
alpha the gloss mask. A `<name>_s.png` beside it (grey: white shines) puts
its own gloss mask in, whichever way the map was made.

These files configure Flametal, not DK2's original executable. A graphics mod does not install shaders or choose a renderer: bloom, HD replacement and hardware RT are host capabilities, and [the fallback shadows](../docs/STATUS.md#two-hosts-two-shadow-paths) are drawn by the same host. For an authored room instead of a lighting override, see [Bathhouse](bathhouse/README.md).

An optional `mod.toml` names and sorts a mod in the list (without one the
folder's name is shown and its files say the kind). The list goes by kind -
graphics, gameplay, content, maps, ai, fix - and by title within one. Write
the title and description in Latin letters: the game's fonts have no others,
and a title they cannot draw shows as blanks.

```toml
title = "Torchlight"
description = "A darker dungeon, a warmer hand light."
kind = "graphics"        # fix, ai, graphics, gameplay, content, maps
author = "..."
version = "1.0"
```

## What a mod can contain

| Path | Effect |
|---|---|
| `render.toml` | Overrides keys of `config/native-render.toml` (lighting colours, radii, intensities, ambients). Only the keys you set change. |
| `textures/<Name>.png` | Replaces the game texture `<Name>` (HD or restyled). Mod textures are layered over your own resource pack in `resource-pack/textures` of the player's data folder (above). |
| `mod.toml` | Its title, description and kind in the Mods tab (above). |
| `game.toml` | Balance: variables, creature fields, native policy (below). |
| `Data/...`, `DK2TextureCache/...` | Any original file at the game's own relative path replaces the game's: definition banks (`Data/editor/Creatures.kwd`, `Rooms.kwd`, ...), levels (`Data/editor/maps/<Name>.kwd` + `<Name>Map.kld`, `Players.kld`, `Things.kld`, `Triggers.kld`, `Variables.kld`, optional `Globals.kld`), text (`Data/Text/Default/*.str`, fonts `*.bf4`), cursors (`Data/Sprite.WAD`). |
| `Data/Meshes/<Name>.kmf` | Replaces one mesh of `Meshes.WAD` (a creature, object or room piece), no WAD rebuild needed. |

Texture names are the game's resource names without the mip suffix, for
example `T_Rock_wall`, `T_Claimed_Path1`, `Treasury_Floor`.

A PNG of any size works; the host scales a single-texture page to the PNG
size (power of two, up to 2048 px). The file name must match exactly.

## Making meshes: `kmf_tool`

No other open tool writes KMF; ours does (src/shared/dk2_mesh/KmfModel.h,
static meshes: room pieces, objects, terrain). `kmf_tool roundtrip <game>`
reads every static mesh of the game and writes it back byte for byte - the
writer's check.

```sh
kmf_tool list    "$GAME" TEMPLE                 # the game's meshes by name
kmf_tool info    "$GAME" TEMPLE12               # materials (textures, flags), surfaces
kmf_tool to-obj  "$GAME" TEMPLE12 temple12.obj  # a piece to look at or start from, for Blender
kmf_tool from-obj bath12.obj mods/bathhouse/Data/Meshes/BATHHOUSE12.kmf --like "$GAME" TEMPLE12
```

`from-obj` makes a material for each `usemtl`, its texture that name (a game
texture, or the mod's `textures/<name>.png`); `--like` takes the material
flags of a game mesh. Coordinates are the game's (import and export with the
same axis settings); a surface holds at most 256 corners and is split past
them; every distance draws the whole mesh; `--flags <texture>=65` makes a
material translucent and drawn after the rest; water is best the game's own
`Water0`, which the engine draws with its water shader. `mods/bathhouse/` is made this way:
its source/pieces.py draws its fifteen pieces (a Roman bath), its
source/make.zsh turns them into the mod's meshes - a template for new rooms
(mods/bathhouse/README.md). A mod ships what it made: pieces changed from the game's
own are the game's files and stay out of it.

### Animated meshes

A creature's move (`Mis_Walk`, `Mis-Idle1`, ...) is an animated KMF with no
skeleton: each point has its own keyframed path, quantised to 10 bits per axis
(the format is written down in KmfModel.h). `roundtrip` covers these too: all
1145 of the game's animated meshes write back byte for byte. A mod gets a new
move by building it on the game's mesh: the same points in the same order,
with the base's materials, triangles, UVs and normals.

```sh
kmf_tool info        "$GAME" Mis_Walk                 # frames, points, keys, surfaces
kmf_tool anim-to-obj "$GAME" Mis_Walk walk/           # walk/Mis_Walk_0000.obj ... one OBJ per frame
kmf_tool anim-from-obj "$GAME" Mis_Walk walk/ mods/mymod/Data/Meshes/Mis_Walk.kmf [--frames 97]
```

Every frame OBJ has the same topology, so Blender can load them as a
sequence or as shape keys. Keep the vertex order: import with splitting by
group/object off, and export without merging or adding points.
A whole new move for a creature of the game: `tools/anim/make_clip.py` lays
a skeleton over one of its frames (`tools/anim/rigs/<Creature>.json`), poses
it by a clip in code (`tools/anim/clips/*.py`) and builds the clip; its README
says how to add a creature or a move.

`anim-from-obj` reads only the `v` lines of the directory's OBJs, sorted by name, one frame
each, and quantises them (each frame lands within half a step of what you
gave, about 1/1000 of the clip's size). The base can be a game member or a
`.kmf` file. `--frames <n>` resamples the clip to n frames linearly. Frame
rate is not part of the mesh: Creatures.kwd sets frames per second for each
move, so more frames play slower. The last frame is only reached, never shown
on its own; a loop's last frame should equal its first. A mod's
`Data/Meshes/<member>.kmf` replaces the game's member of that name.

## Making a new room

A new room is a mod folder; `mods/bathhouse/` is a complete one to copy
(its README walks through it). The parts, in the order they are made:

1. **The room** (`game.toml`): `[new_rooms.<Name>]` with a `base` - the
   original room whose layout and furniture it takes - a `title`, a `cost`,
   an `icon`. `works = true` if it should do the base's work too. Its
   behaviour is the `[rooms.*]` keys (they start as the base's).
2. **What it is for**: usually a need that sends creatures there
   (`[needs.<key>] room = "<Name>"`: how often, how long, health, calm,
   which creatures, `interior = 1` for its inner tiles).
3. **Its look**: its floor's light (`[terrain.<Name>]` `light`, `ambient`,
   `light_height_percent`), a `tint`; for a pool, `wade_percent` and water
   on the game's `Water0` texture (drawn by the engine's water shader).
4. **Its pieces**: `art_from` the base's piece prefix (`kmf_tool list`),
   `art_to` yours, and `Data/Meshes/<art_to><n>.kmf` for each piece you
   make - an OBJ through `kmf_tool from-obj`. Pieces you do not ship are the
   base's. Size and place them as the base's (`kmf_tool to-obj` shows one;
   the game's own pillars are about a quarter of a tile through and reach
   the ceiling, at z -2).
5. **Its centrepiece** (a room whose 5x5 is all room): `[new_objects.*]`
   with your mesh, `ritual_object` and `ritual_effect` in the room's keys.
6. **Its pictures** in `textures/`: the icon (named as its `icon`, `\\`
   written `_`), the pieces' textures. Draw them to repeat; keep them in the
   game's look - dark, painterly, worn.
7. **Try it**: `native_play --mods-root mods --mod <yours> --room <Name> X Y
   W H` lays one at the start; or turn it on in the Mods tab.

Ship only what you made. A piece or picture copied from the game, even
recoloured, is the game's file and stays out of a mod.

## Original files in mods

Files keep the original formats (the editor's `.kwd`/`.kld`, `.str`, `.bf4`,
`.kmf`), so tools made for the original work. The last mod that has a file
wins; everything else is read from the game. A new level is a new `<Name>`
in `Data/editor/maps/`: it shows in the level menu (`run_level.py --menu
--mod <name>`) next to the original ones. Never put original game files in
this repository; a mod ships only what it adds or changes.

## Rules

- Mods never touch the original game files; their own files are read in
  place of the game's.
- Keep a mod to the files above. Anything else in the folder is ignored.
- The base configuration and player settings control the look; `--no-bloom`, `--no-hd`, `--no-rt-shadows` and
  `--mod classicfog` disable those effects or select original-style fog, not the original renderer.

## Examples

`mods/torchlight/` makes the dungeon darker and the hand light warmer and
larger, like carrying a torch.

`mods/original-quirks/` is a Fix-category opt-out for these native bug
fixes. Each key defaults to 1 (fixed); the mod sets it to 0:

| `[policy]` key | Fixed (default) | With the mod |
|---|---|---|
| `fix_web_speed` | Maiden web slows to 10% | The original unsigned `-90` calculation speeds the victim up to its cap; no refresh while a speed modifier is active. |
| `fix_backstab_angle` | Melee bonus relative to the target's facing | Bonus calculated from the attack vector's absolute map angle, regardless of the target's facing. |
| `fix_manufacture_slot` | Workshop reads the head order's threshold | Workshop checks the physical slot-zero threshold, even after the head advances. |
| `fix_area_damage` | Each victim of a blast takes its damage by its own distance | The damage carries on from victim to victim (the last one's is the next one's base), so a blast fades row by row. |

Two more `[policy]` keys change how workers choose (both default to 1):
`workers_rescue_first` has them carry the unconscious and bodies before any
other job - the original looks for loose objects, crates, digging and claiming
first, so with digging ordered a downed creature may lie its minute out;
`wake_workers_on_order` wakes idle workers on a new dig tag or blueprint.
Set either to 0 for the original's behaviour.

To pick a different order for idle workers and for a worker dropped from the hand,
see [Imp triage and the `[workers]` lists](imp-triage/README.md). These only
choose the next job; they do not cancel work in progress or replace combat decisions.

This is not an original-engine compatibility mode. It does not remove native
approximations or the interface. See the [policy audit](../docs/agents/plans/native-policy-audit.md).

`mods/classicfog/` draws the fog of war exactly as the original does: plain
rock blocks over everything unexplored. By default (config/native-render.toml)
they sink under drifting, softly edged mist. The `[fog]` keys: `style`
("modern" | "original"), `color`, `opacity`, `speed`, `scale`, `height`,
`layers`, `glow`.

`mods/depths/` ("Ğ“Ğ»ÑƒĞ±Ğ¸Ğ½Ñ‹") is a whole look: a dark, cold dungeon lit by its
fires - lava, torches, the hand - with deep water and a dense, drifting fog
over what is unexplored. It uses the keys below.

## Graphics: `render.toml`

A mod's `render.toml` sets any keys of `config/native-render.toml` (that file
lists them all with their defaults). Those a look is usually made of:

```toml
[lighting]
ambient = [0.05, 0.045, 0.04]     # added to every lit surface
cap_ambient = [0.55, 0.5, 0.44]   # block tops, so the map reads from above
keep_hue = true                   # light over 1 dims whole and keeps its colour; false: each channel
                                  # clips, as the original (many lava lights turn yellow, then white)

[lighting.terrain]                # the light of every lit floor cell (claimed path, rooms, lava, water)
radius = 2.5                      # tiles, under 4
intensity = 0.5

[lighting.terrain_color]          # one terrain's light colour, by Terrain.kwd id
5 = [0.9, 0.4, 0.1]               # lava (4 is water)
[lighting.terrain_radius]         # ... its own radius
5 = 3.2
[lighting.terrain_intensity]      # ... and intensity
5 = 0.8

[lighting.torch]                  # the game's own lights: wall torches, a portal's, spells' and effects'
intensity = 1.0                   # scales their original intensity
radius = 1.0                      # scales their original radius
tint = [1.0, 1.0, 1.0]            # multiplies their original colour

[lighting.hand]                   # the Keeper hand's light
radius = 3.5
intensity = 0.9
height = 1.25
color = [1.0, 0.86, 0.62]

[backdrop]                        # water and lava
water_alpha = 0.55                # water's opacity at its banks ...
deep_water_alpha = 0.97           # ... and a few tiles out
water_tint = [1.0, 1.0, 1.0]      # multiplies water's colour (0..1)
lava_tint = [1.0, 1.0, 1.0]       # multiplies lava's colour (0..1)
lava_glow = 1.0                   # how hot lava's cracks burn, 0..2
water_foam = 0.5                  # foam where water meets its bank, 0 (none) .. 1
lava_crust = 0.5                  # cooled dark crust where lava meets its bank, 0 (none) .. 1

[relief]                          # normal maps on walls and floors (mods/relief)
strength = 1.0                    # how far the bumps bend the light, 0 off
cavity = 0.35                     # how much ambient a crevice loses
gloss = 0.0                       # highlight strength (times the gloss mask), 0 none
shininess = 32                    # its exponent: higher, smaller and sharper
metal = false                     # the highlight in the picture's colour (gold)
textures = ["t_*", "brick*"]      # texture names, globs, any case

[[relief.group]]                  # textures taking other values (any of the keys above);
textures = ["t_gold*"]            # later groups win, a file's groups replace earlier ones
gloss = 0.6
metal = true

[fog]                             # the fog of war
color = [0.020, 0.018, 0.016]     # what lies deep in it
mist = [0.05, 0.05, 0.05]         # the drifting layers' own colour (lighter: wisps show); unset = color
wisps = 0.45                      # how far the mist thins between its wisps, 0 even .. 1 clear gaps
```

The lighting keys switch at once when a mod is turned on; `[backdrop]` and
`[fog]` take effect from the next level.

## Game balance: `game.toml`

A mod (and the optional `config/game.toml`) can change balance without touching
the original files. Later files win; names that match nothing are logged as
`NATIVE_GAME_CONFIG unknown name ...`.

```toml
[variables]                    # any name from src/shared/dk2_data/VariableTypes.h
PAY_DAY_FREQUENCY_SECONDS = 300

[creatures.Goblin]             # Creatures.kwd name, or "*" for every creature
melee_damage = 200             # keys: statFields() in src/shared/dk2_game/CreatureStats.cpp

[policy]                       # numbers the original files do not hold
meal_seconds = 3               # keys: policyFields() in src/shared/dk2_game/Balance.cpp
```

Creatures' job tables (Creatures.kwd job ids: 3 research, 4 train,
5 manufacture, 6 guard, 7 torture, 8 pray, 9 gamble, 10 leave, 11 attack
rooms, 12 attack walls, 15 sulk, 16 rebel, 24 explore), the computer's
skirmish difficulties and the game's strings:

```toml
[creatures.Goblin]
happy_jobs = [[4, 60], [9, 40]]   # [job, chance %]; also unhappy_jobs, angry_jobs

happy_job1_mood = 10              # one entry's field: happy_job<N>_type / _chance / _mood
                                  # (or a third number in the table: [4, 60, 10])

[ai."*"]                          # or [ai.Master], [ai.Conqueror], ... Paranoid
attack_skill_level = 3            # keys: setAiField() in src/shared/dk2_game/ComputerKeeperPresets.h

[ai_processes.gold]               # what a computer keeper starts when it has nothing on:
weight = 350                      # attack 400, capture 300, gold 200, build 100 (0: never)

[ai_checks.creature_moves]        # what it looks after each turn, in order: untag_gold, retreat,
every = 4                         # defend, create_imps, train, traps_and_doors, prisoners,
                                  # creature_moves, sight_of_evil, end_call_to_arms (on = 0 / every = N)

[text]                            # Text.str strings by id (names, tooltips)
2771 = "Imp"

[messages."0x2e"]                 # an engine message by hex or decimal ID (here: payday)
speech = 1152                     # Speech.str index; -1 silences it
seconds = 50                      # event lifetime (the bar displays at most 50)
icon = 1                          # info 1, creature 2, fight 3
repeat_gap = 30                   # cooldown in seconds, 0 to disable it
duplicates = false               # allow matching live icons to stack
```

A happy job's `mood` is a value the original's records carry (the Mistress and
the Salamander 10 for training, the Monk 20 for prayer) and the original game
loads and never reads. `[policy] job_mood_scale = 10` gives it a use: that
value times the scale comes off every anger each second the creature is at
that job (prayer gives 275 a second). 0, the default, leaves it unread.

Shots and creature spells by their record names (values in the records'
own units: `_x4096` fields are fixed point, 4096 = one tile or one second):

```toml
[shots.Fireball]                  # Shots.kwd name
speed_x4096 = 6144                # keys: setShotField() in src/shared/dk2_game/Balance.cpp
data1 = 80                        # damage; also data2, area, process, flags, target,
fly_effect = 64                   # death_shot and the Effects.kwd ids fly/create/hit_effect

[creature_spells."Raise Dead"]     # CreatureSpells.kwd name
range_x4096 = 24576               # keys: setCreatureSpellField(): data1, data2, range_x4096,
                                  # recharge_x4096, flags, shot
```

Rooms' behaviour beyond their records (the original's room table; keys:
setRoomField() in src/shared/dk2_game/RoomFurniture.h):

```toml
[rooms.Library]                   # Rooms.kwd name
drop = 2                          # a creature set down here: 0 nothing, 1 dazed, 2 the job, 3 eat, 4 take a lair place
drop_job = 3                      # that job (Creatures.kwd job ids: 3 research, 4 train, 5 manufacture, ...)
capacity = 3                      # 0 tiles, 1 none, 2 furniture, 3 furniture + 1, 4 unbounded
```

New rooms start from an existing one: its record and pieces, and a copy of
the terrain its tiles are, so the game tells the two apart on the map. Every
keeper may build it; computer keepers do too, after their own build order.

```toml
[new_rooms.Bathhouse]             # a new name (up to 31 characters)
base = "Temple"                   # the Rooms.kwd room it starts from
title = "Bathhouse"               # its name in the game (else the base's)
cost = 250                        # gold a tile (else the base's)
tint = 0xFFB070                   # its pieces and its panel picture multiplied by this colour
# icon = "gui\\rooms\\bath"       # a panel picture of its own: an EngineTextures name (textures/ can add one)
drop = 0                          # ... and any [rooms.*] key; they start as the base's
```

Its own pieces: `art_from = "TEMPLE"`, `art_to = "BATHHOUSE"` rename the
pieces it draws (TEMPLE3 becomes BATHHOUSE3); a mod ships
`Data/Meshes/BATHHOUSE3.kmf` for those it changes, the rest stay the base's.

What a new room does is what the rules that name it say: a need
(`[needs.*] room = "Bathhouse"`, below), its own `[rooms.*]` keys. With
`works = true` it does its base's own work too and counts as one of them:

```toml
[new_rooms.Archive]
base = "Library"
works = true                      # researched in, furnished with bookcases, counted as a library
tint = 0xB0C0FF
```

Two more `[rooms.*]` keys draw a room: `wade_percent = 45` lowers who stands
on its inner tiles into a sunken pool (waist-deep), `ambience_seconds = 2`
lets its record's own effects (a Temple copy's pool mist and bubbles) rise
over it near the camera. A need's `interior = 1` sends the creature to an
inner tile, `centre = 1` first to the centre of the room's 5x5 (its
centrepiece), and `clip = "<key>"` plays a move of the mod's there in place of
`animation`, for the creatures given one:

```toml
[needs.club]
clip = "pole_dance"
centre = 1
[creature_animations.Mistress]    # Data/Meshes/MIS_PoleDance.kmf in the mod
pole_dance = { mesh = "MIS_PoleDance", fps = 20 }
```

A creature at the centre is drawn from the tile's centre, facing the map's
+y, so a move made about the centrepiece lines up with it. A creature with no
clip for that key plays `animation`. A mesh material on the game's water texture (`Water0`) is drawn
by the engine's own water shader, as the map's water is.

Its centrepiece: where a Temple whose 5x5 is all room raises its hand (a
Crypt its bell), a room may stand an object of its own, with an effect rising
from it - the Bathhouse's steaming fountain. A mod adds the object:

```toml
[new_objects."Bath Fountain"]     # an Objects.kwd record copied
base = "Temple Hand"
mesh = "BATH_FOUNTAIN"            # Data/Meshes/BATH_FOUNTAIN.kmf in the mod

[rooms.Bathhouse]                 # or in [new_rooms.*]
ritual_object = "Bath Fountain"
ritual_effect = "Workshop Steam"  # an Effects.kwd name (or id)
ritual_effects_per_second = 1
```

A new door or trap is a copy of the game's record with a name, a panel picture, meshes and numbers
of its own; every keeper may make it in the Workshop (its crate is its base's: a crate knows what
it holds):

```toml
[new_traps."Frost Trap"]          # a Traps.kwd record copied
base = "Freeze Trap"
title = "Frost Trap"              # its name in the game
icon = "gui\\traps\\frost"          # its panel picture (an EngineTextures name; a mod's textures/ can add it)
art_from = "Trap_"                # its meshes: Trap_Freeze becomes Frost_Freeze (Data/Meshes in the mod)
art_to = "Frost_"                 #   prefixes match case as the record spells them
health = 777                      # also gold_cost, manufacture_points, health_per_second,
recharge_x4096 = 8192             #   mana_per_shot, trigger_tiles, data1, data2, threat, mana_upkeep
shot = "Fireball"                 # the shot it fires, by name (a [new_shots.*] too)

[new_doors."Iron Door"]           # a Doors.kwd record copied
base = "Steel Door"
health = 4321                     # also gold_cost, manufacture_points, health_per_second
art_from = "DOOR_"                # its mesh (Doors.kwd 0x248) and ArtResources
art_to = "IRON_"
```

More objects stand round the centre with `around_centre = [["Bar Counter",
0, -2, 0]]` (object, tiles across and down from it, yaw in degrees; yaw 0
keeps the mesh's x along the map's x). The Strip Club's bar is one. A mod's
object mesh is drawn as the pieces are, its floor at z -1.
`along_walls = [["Club Table", 2]]` stands an object on every n-th tile beside
a solid wall (not in a corner, by an opening or by an object round the
centre), its back to the wall: the bigger the room, the more of them. The
Strip Club's tables are these.

Without it (the Bathhouse) it is furnished as its base but nothing of the
base's own work comes with it: a Temple's copy takes no prayer or sacrifice. `tint` works for `[rooms.*]` too. A room without a
tint or icon of its own shares its base's picture and is left out of the
panel, as the original's rooms that share one are.

New terrain starts from an existing one: its record - flags, art, light -
under a new name, drawn as its base is (a terrain made from water is water,
lit by its own light). A map refers to terrain by id, so a mod that ships
maps gives its terrain the id its maps use; `id` must be free (the game's
end at 36). `[terrain.<name>]` changes any terrain, the game's too.

```toml
[new_terrain."Hot Spring"]
base = "Water"                    # a Terrain.kwd name
id = 200                          # 0 or left out: the first free
damage = -40                      # a turn, to whoever stands in it; below 0 heals
light = [255, 150, 90]            # the light it gives, 0..255 ([0, 0, 0]: none)
tint = 0xFFC090                   # its pieces drawn in this colour (liquids take their light's)

[terrain.Lava]
damage = 250                      # the game's lava, hotter
```

Keys: `damage`, `gold`, `mana`, `max_mana`, `health`, `max_health`,
`light`, `ambient`, `light_height_percent`, `flags` (the whole flag word) or
`solid`, `indestructible`, `diggable`, `water`, `lava` (0 / 1), the art
`top`, `side`, `complete`, `tagged` (mesh or texture names), `turns_into`
and `dug_into` (a terrain by name: what it becomes claimed or reinforced,
and dug out), `tint` (src/shared/dk2_game/ModDefinitions.cpp). `native_play
--terrain "Hot Spring" X Y W H` lays one for a look.

New creatures start from an existing one (its record, art and animations)
and take the same keys as `[creatures.*]`; `pool` puts that many in every
keeper's creature pool, so they come through portals when their rooms are
built (the base's attractions, or its own: `attraction = [["Torture Chamber",
16], ["Strip Club", 9]]`, two rooms at most with their least tiles, the first
its favourite - the more of it, the likelier; a room no mod in play adds is a
want that cannot be met, so it does not come). `attraction` works in
`[creatures.*]` too.

```toml
[new_creatures."Fire Goblin"]     # a new name (up to 31 characters)
base = "Goblin"                   # the Creatures.kwd creature it starts from
title = "Fire Goblin"             # its name in the game (else the base's)
pool = 3
melee_damage = 320
```

Its pictures: `portrait` (the tall card, 1:2) and `icon` (the square), by
EngineTextures name. A name the game does not have is read from the mod's
`textures/` as `<name>.png`, with `\` written `_`: `portrait =
"gui\\creatures\\evil\\overseer-bg"` is `textures/gui_creatures_evil_overseer-bg.png`.
Without them it has its base's.

How it is drawn without meshes of its own: `tint = 0xD86A5A` multiplies its
colour (0xRRGGBB), `scale_percent = 114` its size. Both work for
`[creatures.*]` too.

The light it carries (Creatures.kwd 0xD94; the Imp's and Dwarf's lanterns,
the Firefly's glow): `light_color = 0xRRGGBB` (0: none), `light_radius` and
`light_height` (above it) in 4096ths of a tile, `light_flags` (0x2 flicker,
0x4 pulse, 0x80 in its keeper's colour, 0x800 / 0x1000 / 0x2000 a full red /
green / blue added), `light_strength_percent` (100). `render.toml`'s
`[lighting.torch]` scales these too.
`mods/glow/` lights the elite Firefly and the Fairy, which have none.

Its own meshes: `art_from = "Gob"`, `art_to = "FireGob"` rename its
ArtResources (Goblin-Walk becomes FireGoblin-Walk, ...); a mod ships
`Data/Meshes/<new name>.kmf` for those it changes, the rest stay the base's.

New shots and creature spells start from existing ones the same way, and a
creature takes a spell by its name in a slot:

```toml
[new_shots."Fire Spit"]
base = "Fireball"                 # a Shots.kwd name; [shots.*] keys
data1 = 120

[new_creature_spells."Fire Spit"]
base = "Warlock Fireball"         # a CreatureSpells.kwd name; [creature_spells.*] keys
shot = "Fire Spit"                # a shot by name or id

[creatures.Goblin]                # or [new_creatures.*]
spell1 = "Fire Spit"              # slots spell1..spell3, by name or id
spell1_level = 3                  # the level it comes at
```

Unique creatures come, once, to a keeper whose rooms form a pattern (the
original's 13 are built in, src/shared/dk2_game/UniqueCreatures.h). A mod
replaces one or adds its own, for any creature (a new one too):

```toml
[unique_creatures."Fire Goblin"]  # the creature it brings
key_room = 4                      # Rooms.kwd id of the key room (Hatchery)
key_tiles = 1                     # its exact size
grid = [[4, 2, 4],                # from the key room's top-left: room ids
        [2, 2, 2],                # (here Hatchery corners round a Lair cross)
        [4, 2, 4]]
```

An aura is what a creature does to its keeper's other creatures near it
(native: the original has none). The keys go with a creature's others:

```toml
[new_creatures.Overseer]          # or [creatures.*]
aura_tiles = 3                    # its reach
aura_work_percent = 40            # their work in rooms and the workers' digging go this much faster
aura_heal = 0                     # health a second
aura_anger = 40                   # a second: above 0 onto the anger a night in the lair clears,
                                  # below 0 off every anger (a calming presence)
```

The giver must be up and free (not knocked out, held or a captive) and does
not affect itself; of several in reach the health and anger add up, the best
work rate counts.

A creature's needs are a table (`src/shared/dk2_game/Needs.h`). Every game
turn the rules are tried in `order`; the first that is due and can start takes
the creature from what it does, if the rule may take it from that. The
original's four are built in: `hunger` (order 10), `sleep` (20), `pay` (30)
and `health` (40: a tired creature that is badly hurt does not wait between
tries). A mod changes them, or adds needs of its own: due every so many
seconds, met by a stay at a room of the keeper's.

```toml
[needs.hunger]
percent = 150                     # of the creature's own time between meals (sleep: its time awake;
                                  # health: the health it hurries to bed below)
retry_turns = 4                   # game turns between tries while it is due (4 a second)
interrupts = ["research", "train", "manufacture", "guard", "pray", "gamble", "sulk", "cheer"]
                                  # what it takes a creature from (this list is the original's);
                                  # one with nothing to do is always taken
# enabled = false                 # switches a need off

[needs.bath]                      # a new need
every_seconds = 600               # due this long after it was last met (or the creature came)
room = "Hatchery"                 # a Rooms.kwd name: a free tile of one of its keeper's
stay_seconds = 10
heal_percent = 20                 # of its full health, over the stay
calm = 2000                       # taken off each of its angers when met (unhappy from about 16000)
drunk_percent = 0                 # chance when met of the drunk walk (kinds that have one, animation 34)
drunk_seconds = 45                # ... for this long
anger_per_turn = 5                # added for each turn it is due and no room can be reached -
                                  # only if its keeper may build that room or has one
animation = 23                    # its animation slot there (20 idle, 23 praying, 12 sleeping, 13 eating)
creatures = ["Goblin", "Troll"]   # only these kinds; leave out for all
order = 25                        # between sleep and pay
```

Work in a room has no clock, as in the original: it goes on until a need or
an unhappy mood takes the creature, or the work gives out (no gold for
training, nothing to research or make, the gambler's purse empty).
`[policy] job_session_seconds = 30` ends every session after that long instead.

`mods/habits/` gives every kind a comfort of its own - a craft it enjoys
(the records' unused job moods, switched on) or a room it visits;
`mods/fiercer-ai/` makes the computer keepers attack sooner in skirmish;
`mods/fire-goblin/` adds the Fire Goblin with its Fire Spit;
`mods/overseer/` the Overseer, whose aura drives those near her;
`mods/bathhouse/` a new room, the Bathhouse, and the need that fills it;
`mods/swift-shots/` makes creature shots fly twice as fast and hit wider.

`[policy]` covers values that are native choices or were read from the
executable rather than the data files (meal time, knock-out time, a work
session's length, a flying shot's hit radius and extra range, a hero digger's rock
cost, a hero's replanning delay, possessing chickens, how hard a walker brakes - `walk_brake_percent`,
35 the original's glide); see `Policy` in
`src/shared/dk2_game/Systems.h`.

Creature values are the level-1 base; levels 2..10 scale them by the level's
CreatureStatLevels percentages, as the original does.

## Factions: `[factions.<name>]`

A faction is a side a keeper takes in the skirmish set-up (each keeper's row gets a choice
of side once a mod in play has one; `native_play --faction 4 Heroes`). Its portal brings
only the creatures it lists, with how many - any creature, heroes too, each still wanting
its rooms; `rooms`, `spells`, `traps` and `doors` list all of those it may ever have (a list
left out: all of them). What it may not have stays out whatever else is available.
`mods/hero-keeper/` is one: the keeper of the heroes.

```toml
[factions.Heroes]
title = "Heroes"                                  # its name in the set-up
creatures = [["Dwarf", 12], ["Knight", 10]]        # its portal's pool instead of the map's
rooms = ["Dungeon Heart", "Portal", "Treasury", "Lair", "Hatchery", "Combat Pit"]
```

Allies (the set-up's teams, the map's PLAYER_ALLIANCE, the script's SET_ALLIANCE) do not
fight each other, win together, open each other's doors and drop creatures on each other's
ground. They also share what they have explored (`[policy] allies_share_sight`, default 1; 0 is
the original, where allies share no sight).

## The control panel and indicators: `[hud]`

The dock's tabs are data. Each tab lists selectors over the game's records -
`kind:*`, `kind:Name` or `kind:id`, the kind one of `room`, `spell`, `door`,
`trap`, `creature` - so a room, spell or creature a mod adds to the game shows
up in the tab whose selector takes it, and a mod can add tabs of its own:

```toml
[[hud.tab]]
key = "defences"                  # its stable name
title = "Defences"                # or title_text = 330, a Text.str id
icon = "gui\\tabs\\t-workshop"    # an EngineTextures name; textures/ can add one
items = ["door:*", "trap:Sentry Trap"]
after = "spells"                  # omitted: last

[hud.tabs]
hide = ["workshop"]               # the original four: creatures, rooms, spells, workshop
order = ["rooms", "creatures"]    # these first; the rest keep their order

[hud.colours]
players = [[191, 213, 224], [255, 255, 255], [230, 50, 50]]  # by player number from 1: heroes, neutral, keepers
rainbow_neutral = false           # neutral creatures' indicators stay white
```

A tab of `creature:` selectors shows tall portrait cards (the record's `-bg`
picture) with counts and the Total / Jobs / Combat / Moods views. The dock's
size comes from the screen alone, so tabs never move; what does not fit in a
tab scrolls sideways.

The indicators over creatures, doors and traps (health ring, level / mood /
work ball, side colour) follow the original's rules, and the keeper's calm
creatures show theirs too once the view is close; the setting *Creature
indicators* turns them off or shows all. In code both are open: a tab takes a
`collect` function for items that are not records (`Hud::panelTabs()`), and
`Hud::indicators().addSource()` adds markers of any kind.

## Testing an AI mod

`tools/native/ai_tournament.py --mod <name> --compare` plays computer keepers
against each other on every skirmish map (no window, all cores) with and
without the mod and prints both: games decided, time to win, keepers that
attacked and when, creatures, gold and land. `--maps`, `--seeds`,
`--minutes`, `--per-map` and `--out runs.jsonl` narrow or keep a run.

## Testing a mod by hand: the Debug tab

`mods/debug/` adds a Debug tab to the panel. Its buttons give 10000 gold,
which goes into the stores first and is piled by the heart when they are full.
They also fill the treasuries, fill the mana, raise every creature of the
keeper one level and reveal the map. After the buttons comes one card for every
creature kind, including any a mod adds, such as the Overseer. A card spawns that
creature for the keeper on the open tile nearest the middle of the view.

```sh
native_play --game "$GAME" --level Circlet --skirmish --mods-root mods --mod debug --mod overseer
```

The tab is an ordinary `[[hud.tab]]` whose items are the `debug:*` selector,
so any mod can show it in the same way. Each button sends a command to the
game, just as the player's orders do. A save keeps those commands and plays
them again when it is loaded. Without such a tab nothing sends them.
